# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# Manifest.toml IS committed here (this is an application, not a package library).
# A pinned Manifest ensures `Pkg.instantiate()` in the Dockerfile resolves the
# exact same dependency versions without hitting the network.

# Results and top-level data files (not spot-check datasets)
results/
data/*.h5
data/task-*/README.md
